# AI Gateway authentication (server-side only)
AI_GATEWAY_API_KEY=
KNOWLEDGE_AI_PROVIDER=vercel

# Use stable model IDs available in your Vercel AI Gateway account.
KNOWLEDGE_AI_MODEL=google/gemini-3.6-flash
KNOWLEDGE_AI_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-5.4-mini

# Generation safety controls
KNOWLEDGE_AI_TIMEOUT_MS=90000
KNOWLEDGE_AI_MAX_CONCURRENCY=4
KNOWLEDGE_CONTEXT_MAX_SOURCES=8
KNOWLEDGE_CONTEXT_MAX_CHARS=48000

# Main customer-service chat
DEFAULT_AI_PROVIDER=vercel
CHAT_AI_MODEL=google/gemini-3.6-flash
CHAT_AI_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-5.4-mini
CHAT_AI_TIMEOUT_MS=45000
CHAT_AI_MAX_OUTPUT_TOKENS=1200
CHAT_AI_MAX_CONCURRENCY=20
CHAT_AI_MAX_HISTORY_CHARS=24000
CHAT_KNOWLEDGE_MAX_CHARS=16000

# Vercel Queue channel processing and MongoDB recovery agent
CHANNEL_QUEUE_RETENTION_SECONDS=604800
CHANNEL_QUEUE_VISIBILITY_SECONDS=900
CHANNEL_JOB_ATTEMPTS=8
CHANNEL_JOB_BACKOFF_SECONDS=5
CHANNEL_JOB_MAX_BACKOFF_SECONDS=300
CHANNEL_DIRECT_FALLBACK=true
CHANNEL_RECOVERY_BATCH_SIZE=10
CHANNEL_RECEIVED_STALE_MS=60000
CHANNEL_QUEUED_STALE_MS=600000
CHANNEL_RETRYING_STALE_MS=300000
CHANNEL_PROCESSING_STALE_MS=900000
CRON_SECRET=

# Instagram Messaging / Meta webhook verification
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
